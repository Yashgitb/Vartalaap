# ==============================================================================
# VARTALAAP - ENVIRONMENT CONFIGURATION
# Backend-only Groq API Configuration (Speech-to-Text & LLM Summarisation)
# ==============================================================================

# Required: Your Groq API Key (Obtain from https://console.groq.com/keys)
# Keep this secure on the backend. It will never be exposed to the client frontend.
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Speech-to-Text Transcription Model
# Official Supported Model: whisper-large-v3-turbo
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Groq LLM Text Summarisation Model
# Official Supported Models: llama-3.3-70b-versatile, llama-3.1-8b-instant
GROQ_SUMMARY_MODEL=llama-3.3-70b-versatile

# Maximum Upload File Size in Megabytes (Groq limits audio files to 25MB)
MAX_FILE_SIZE_MB=25

# Network Timeouts & Bounded Retries
REQUEST_TIMEOUT_SECONDS=60.0
MAX_RETRIES=3
RETRY_BACKOFF_FACTOR=1.5

# Server Network Settings
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
